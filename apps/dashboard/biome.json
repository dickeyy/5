{
    "$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
    "root": false,
    "extends": "//",
    "files": {
        "includes": [
            "src/**/*",
            "index.html",
            "vite.config.ts",
            "!src/routeTree.gen.ts",
            "!src/styles.css"
        ]
    },
    "linter": {
        "domains": {
            "tailwind": "recommended"
        },
        "rules": {
            "nursery": {
                "useSortedClasses": "on"
            }
        }
    }
}
